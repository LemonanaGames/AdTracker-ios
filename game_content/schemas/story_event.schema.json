{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "story_event.schema.json",
  "title": "Story event (narrative/events.json → events[])",
  "type": "object",
  "required": ["id", "act", "version", "oncePerLife", "titleKey", "sceneAssetKey", "trigger", "lines", "choices"],
  "properties": {
    "id": { "type": "string" },
    "act": { "enum": ["prologue", "act1", "act2", "act3", "act4"] },
    "version": { "type": "integer", "minimum": 1 },
    "oncePerLife": { "type": "boolean" },
    "titleKey": { "type": "string" },
    "sceneAssetKey": { "type": "string" },
    "trigger": { "$ref": "requirement.schema.json" },
    "lines": { "type": "array", "items": { "type": "object", "required": ["speaker", "textKey"] }, "minItems": 1 },
    "choices": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "labelKey", "effects"],
        "properties": {
          "id": { "type": "string" },
          "labelKey": { "type": "string" },
          "requirement": { "$ref": "requirement.schema.json" },
          "effects": {
            "type": "object",
            "properties": {
              "integrity": { "type": "integer" },
              "audienceTrust": { "type": "integer" },
              "cashMinor": { "type": "integer" },
              "xp": { "type": "integer", "minimum": 0 },
              "relationships": { "type": "object", "additionalProperties": { "type": "integer" } },
              "modifiers": { "type": "array" }
            }
          },
          "deferredFlags": { "type": "array", "items": { "type": "string" } },
          "nextEventId": { "type": "string" }
        }
      }
    },
    "analyticsTags": { "type": "array", "items": { "type": "string" } },
    "designerNotes": { "type": "string" }
  }
}
